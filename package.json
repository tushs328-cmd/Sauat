{
  "name": "saulat-sauat",
  "version": "1.0.0",
  "private": true,
  "description": "Сауат — офлайн-платформа функциональной грамотности для 7–9 классов",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "build:static": "node scripts/build-static.mjs",
    "build:demo": "node scripts/build-static.mjs --include-draft",
    "pack:site": "node scripts/pack-site.mjs",
    "size": "node scripts/size.mjs",
    "test:static": "node scripts/static-smoke.mjs",
    "qa": "node scripts/qa.mjs",
    "eval:ai": "node eval/run-eval.js",
    "eval:persona": "node eval/persona/run-eval.js",
    "validate": "node src/content-validator.js",
    "content:manifest": "node src/content.js",
    "test:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File test/docker-smoke.ps1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1"
  }
}

    { "id": "t2", "type": "infer_evidence", "skill": "infer", "question": { "kk": "e2 мен e4 қандай қатынасты көрсетеді?", "ru": "Какое отношение описывают e2 и e4?" }, "options": [{ "id": "a", "text": { "kk": "Қазақстан аумағында Ресейдің жалға алуы.", "ru": "Аренду Россией на территории Казахстана." } }, { "id": "b", "text": { "kk": "Қазақстанның ғарыш айлағын сатып алуы.", "ru": "Покупку Казахстаном космодрома." } }, { "id": "c", "text": { "kk": "Екі елдің шекара дауы.", "ru": "Пограничный спор двух стран." } }], "correctOptionIds": ["a"], "requireEvidence": true, "acceptedEvidenceSets": [["e2", "e4"]], "hints": [{ "id": "t2_h1", "level": 1, "strategy": "compare", "text": { "kk": "Жалға алушы мен жалға берушіні салыстыр.", "ru": "Сравни арендатора и арендодателя." } }, { "id": "t2_h2", "level": 2, "strategy": "compare", "text": { "kk": "e4-тегі екі рөл кімге тиесілі?", "ru": "Кому принадлежат две роли в e4?" } }, { "id": "t2_h3", "level": 3, "strategy": "compare", "text": { "kk": "Қазақстан аумағындағы Ресей жалдауын таңда.", "ru": "Выбери аренду Россией на территории Казахстана." } }], "explanation": { "kk": "e2 жалға алуды, e4 тараптардың рөлін көрсетеді.", "ru": "e2 говорит об аренде, e4 распределяет роли сторон." } },

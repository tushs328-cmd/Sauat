  "documents": [{ "id": "d1", "title": { "kk": "Байқоңыр туралы үзінділер", "ru": "Фрагменты о Байконуре" }, "isFictional": false, "segments": [
    { "id": "e1", "text": { "kk": "ESA мәтінінде Байқоңырдың Қазақстан даласында орналасқаны және ғарыш айлағы ретінде пайдаланылатыны жазылған.", "ru": "В тексте ESA сказано, что Байконур находится в степи Казахстана и используется как космодром." }, "sourceId": "esa_baikonur_cosmodrome" },
    { "id": "e2", "text": { "kk": "Байқоңыр ғарыш айлағын Ресей Қазақстан аумағында жалға алады.", "ru": "Россия арендует космодром Байконур на территории Казахстана." }, "sourceId": "kazcosmos_baikonur" },
    { "id": "e3", "text": { "kk": "Жалға алу туралы келісім 1994 жылы жасалған, жылдық төлемі 115 миллион АҚШ доллары деп көрсетілген.", "ru": "В соглашении об аренде 1994 года указана ежегодная плата 115 миллионов долларов США." }, "sourceId": "gov_kz_baikonur_lease" },
    { "id": "e4", "text": { "kk": "Келісімде Қазақстан жалға беруші, ал Ресей жалға алушы ретінде сипатталады.", "ru": "В соглашении Казахстан описан как арендодатель, а Россия — как арендатор." }, "sourceId": "gov_kz_baikonur_lease" }
  ] }],
